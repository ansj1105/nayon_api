DB_NAME=nayon
DB_USERNAME=nayon
DB_PASSWORD=replace-with-db-password
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/replace-with-user-pool-id
COGNITO_JWK_SET_URI=https://cognito-idp.us-east-1.amazonaws.com/replace-with-user-pool-id/.well-known/jwks.json
COGNITO_CLIENT_ID=replace-with-client-id
NAYON_AUTH_PROVIDER=GOOGLE
KORION_WALLET_LINK_BASE_URL=http://foxya-api:8080
KORION_WALLET_LINK_INTERNAL_API_KEY=replace-with-shared-internal-key
STORE_ACCOUNT_HASH_KEY=replace-with-random-32-byte-secret
GOOGLE_PLAY_PACKAGE_NAME=com.korion.Nayon
GOOGLE_PLAY_CREDENTIALS_HOST_FILE=/secure/path/google-play-service-account.json
GOOGLE_PLAY_RTDN_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_PLAY_RTDN_AUDIENCE=https://replace-with-api-host/api/v1/public/google-play/rtdn
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=replace-with-pubsub-push-service-account@example-project.iam.gserviceaccount.com
